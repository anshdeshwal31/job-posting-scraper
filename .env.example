# ─── Required ─────────────────────────────────────────────────────────────────

# Neon PostgreSQL connection string (connection pooling via Neon proxy)
DATABASE_URL="postgresql://user:password@host.neon.tech:5432/dbname?sslmode=require&pgbouncer=true"

# Direct connection (for Prisma migrations — bypasses PgBouncer)
DIRECT_URL="postgresql://user:password@host.neon.tech:5432/dbname?sslmode=require"

# Inngest (from https://app.inngest.com/)
INNGEST_SIGNING_KEY="signkey-prod-..."
INNGEST_EVENT_KEY="..."

# ─── Optional ─────────────────────────────────────────────────────────────────

# Full public URL of this deployment (used by SandboxSource to self-call)
# In production this is set automatically by Vercel
NEXT_PUBLIC_APP_URL="http://localhost:3000"
